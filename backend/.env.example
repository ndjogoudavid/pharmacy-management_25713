# Database
PGHOST=localhost
PGPORT=5432
PGDATABASE=pharmacydb
PGUSER=postgres
PGPASSWORD=changeme

# JWT
JWT_SECRET=change-me-to-a-strong-secret
JWT_EXPIRATION_MS=3600000

# Mail (SMTP) - used for 2FA and password reset emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your@email.example
SMTP_PASSWORD=your-smtp-password
SMTP_AUTH=true
SMTP_STARTTLS=true
SMTP_STARTTLS_REQUIRED=true
SMTP_CONNECTION_TIMEOUT=5000
SMTP_TIMEOUT=5000
SMTP_WRITE_TIMEOUT=5000

# Frontend URL used inside password reset emails
FRONTEND_RESET_URL=http://localhost:5173/reset-password

# Enable console logging of 2FA/reset codes (set to false in production)
APP_LOG_CODES=false
